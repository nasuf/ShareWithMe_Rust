# Use 127.0.0.1:8080 for local-only desktop/simulator testing.
# Use 0.0.0.0:8080 when a real phone needs to reach this backend over LAN.
SHARE_WITH_ME_BIND=0.0.0.0:8080
SHARE_WITH_ME_STORE_BACKEND=supabase
SHARE_WITH_ME_STORE=share_with_me_store.json
SHARE_WITH_ME_MEDIA=media
SHARE_WITH_ME_RENDERER=tools/render_extract.mjs
# Strongly recommended on an internet-facing server. The Flutter app can send
# the same value via --dart-define=SHARE_WITH_ME_API_TOKEN=...
# SHARE_WITH_ME_API_TOKEN=
# Optional video metadata/subtitle extractor. Production installs this pinned binary.
SHARE_WITH_ME_YTDLP=yt-dlp
# Optional Netscape cookie file for content the user is authorized to access.
# SHARE_WITH_ME_YTDLP_COOKIES=/app/secrets/yt-dlp-cookies.txt

# Optional OpenAI-compatible speech-to-text endpoint. Video subtitles are used
# first; ASR is only invoked when a public video has no usable caption track.
# SHARE_WITH_ME_ASR_URL=https://api.openai.com/v1/audio/transcriptions
# SHARE_WITH_ME_ASR_API_KEY=
# SHARE_WITH_ME_ASR_MODEL=whisper-1
# SHARE_WITH_ME_ASR_LANGUAGE=zh
# SHARE_WITH_ME_ASR_MAX_SECONDS=7200
# SHARE_WITH_ME_ASR_MAX_BYTES=100663296

# Optional official platform enrichments. Without these, public page/share data is retained.
# INSTAGRAM_OEMBED_TOKEN=
# AMAP_WEB_SERVICE_KEY=
# BAIDU_MAPS_AK=

DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
# Prefer setting this in your shell or key.txt. Do not commit real keys.
# DEEPSEEK_API_KEY=

# Backend storage uses a Postgres connection through Supabase's IPv4 pooler.
# You may set SUPABASE_DATABASE_URL directly instead of the fields below.
# SUPABASE_DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_PROJECT_REF=metykjthuctqcwwutrnn
SUPABASE_URL=https://metykjthuctqcwwutrnn.supabase.co
SUPABASE_REGION=ap-northeast-1
SUPABASE_POOLER_HOST=aws-1-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_PASSWORD=<database-password>

# Keep client/API keys out of git; use GitHub Secrets or local .env when needed.
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=https://metykjthuctqcwwutrnn.supabase.co/auth/v1/.well-known/jwks.json
